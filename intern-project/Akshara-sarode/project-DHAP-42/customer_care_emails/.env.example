# Copy to .env before starting. These development-only defaults are local; replace them for non-local use.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=dhap42-airflow:local
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=airflow@example.com
AIRFLOW_FERNET_KEY=REPLACE_WITH_A_FERNET_KEY
AIRFLOW_WEBSERVER_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=customer-care-emails
MINIO_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
